{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maranatha",
  "version": "1.0.0",
  "identifier": "com.maranatha.overlay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Maranatha",
        "width": 1920, "height": 48,
        "visible": false, "transparent": true, "decorations": false,
        "alwaysOnTop": true, "skipTaskbar": true, "resizable": false,
        "focus": false, "shadow": false
      },
      {
        "label": "settings",
        "title": "Maranatha Settings",
        "url": "index.html",
        "width": 380, "height": 620,
        "visible": false, "center": true,
        "transparent": false, "decorations": true,
        "alwaysOnTop": false, "resizable": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Your Name",
    "shortDescription": "Christmas taskbar overlay",
    "icon": ["icons/32x32.png","icons/128x128.png","icons/128x128@2x.png","icons/icon.icns","icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}